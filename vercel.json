{
  "buildCommand": "npm install && node build.js",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
}
